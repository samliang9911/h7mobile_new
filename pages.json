{

	"easycom": {
		"autoscan": true,
		// 注意一定要放在custom里，否则无效，https://ask.dcloud.net.cn/question/131175
		"custom": {
			"^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/Guide/splash",
			"style": {
				"navigationBarTitleText": "综合管理系统-H7",
				"navigationStyle": "custom", //顶部栏透明
				"enablePullDownRefresh": false //下拉刷新
			}
		},
		{
			"path": "pages/Guide/Guide",
			"style": {
				"navigationBarTitleText": "引导页",
				"navigationStyle": "custom", //顶部栏透明
				"enablePullDownRefresh": false //下拉刷新
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "综合管理系统-H7",
				"enablePullDownRefresh": false,
				"navigationStyle": "custom" //顶部栏透明
			}

		},
		{
			"path": "pages/index/items",
			"style": {
				"navigationBarTitleText": "事项",
				"navigationBarBackgroundColor": "#FFFFFF",
				"navigationStyle": "custom", //顶部栏透明
				"onReachBottomDistance": 80, //上拉触底
				"enablePullDownRefresh": false //下拉刷新
			}
		},
		{
			"path": "pages/index/func",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "功能",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/index/home",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "首页",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/index/dashboard",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "仪表盘",
				"enablePullDownRefresh": false
			}

		},
		{
			"path": "pages/index/user",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "用户",
				"enablePullDownRefresh": false
			}
		}

	],



